<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Referencias a proyectos internos de la solución -->
  <ItemGroup>
    <!-- Infrastructure depende de Domain (entidades e interfaces) -->
    <ProjectReference Include="..\TaskManagement.Domain\TaskManagement.Domain.csproj" />
    <!-- Infrastructure depende de Application (interfaces de repositorios viven allí) -->
    <ProjectReference Include="..\TaskManagement.Application\TaskManagement.Application.csproj" />
  </ItemGroup>

  <!-- Paquetes NuGet: ÚNICAMENTE Entity Framework Core -->
  <ItemGroup>
    <!-- Proveedor de SQL Server para EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <!-- Herramientas de EF Core: dotnet ef migrations add, dotnet ef database update -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>

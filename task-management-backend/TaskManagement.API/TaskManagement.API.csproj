<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Habilitar comentarios XML para que Swagger los lea y los muestre en la UI -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suprimir advertencias por miembros sin comentario XML (solo aplicamos donde importa) -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger/OpenAPI: genera la UI interactiva en /swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- EF Core Design: necesario para que "dotnet ef" funcione desde el proyecto API -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- API depende de Application (servicios, DTOs) -->
    <ProjectReference Include="..\TaskManagement.Application\TaskManagement.Application.csproj" />
    <!-- API depende de Infrastructure (DbContext para DI y migraciones) -->
    <ProjectReference Include="..\TaskManagement.Infrastructure\TaskManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
